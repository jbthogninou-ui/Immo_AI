# ============================================================
# ImmoFlow AI API - Variables d'environnement
# ============================================================
APP_NAME="ImmoFlow AI API"
ENVIRONMENT=development           # development | staging | production
DEBUG=true
API_V1_PREFIX=/api/v1
SERVER_HOST=0.0.0.0
SERVER_PORT=8000

# ---------- Sécurité ----------
# openssl rand -hex 32
SECRET_KEY=change-me-super-secret-key-please-rotate-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=60
BCRYPT_ROUNDS=12

# ---------- CORS ----------
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]
ALLOWED_HOSTS=["*"]

# ---------- PostgreSQL ----------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=immoflow
POSTGRES_PASSWORD=immoflow
POSTGRES_DB=immoflow
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_ECHO=false

# ---------- Redis ----------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# ---------- Stockage fichiers ----------
STORAGE_BACKEND=local             # local | s3
UPLOAD_DIR=./storage
MAX_UPLOAD_SIZE_MB=25
PUBLIC_BASE_URL=http://localhost:8000

# ---------- Email (SMTP) ----------
SMTP_ENABLED=false
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_TLS=true
EMAIL_FROM=no-reply@immoflow.ai
EMAIL_FROM_NAME=ImmoFlow AI

# ---------- Frontend (liens d'invitation / reset) ----------
FRONTEND_BASE_URL=http://localhost:5173

# ---------- IA ----------
AI_PROVIDER=none                  # none | openai | groq | anthropic
AI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_TIMEOUT_SECONDS=45

# ---------- Rate limiting ----------
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=120

# ---------- Bootstrap Super Admin ----------
FIRST_SUPERADMIN_EMAIL=admin@immoflow.ai
FIRST_SUPERADMIN_PASSWORD=ChangeMe123!
