# ============================================================
# ImmoFlow AI — Frontend
# ============================================================

# URL de l'API backend.
# Laissez /api pour utiliser le proxy Vite en développement.
VITE_API_URL=/api/v1

# Cible du proxy Vite (uniquement en développement)
VITE_PROXY_TARGET=http://localhost:8000

# URL du WebSocket temps réel
VITE_WS_URL=ws://localhost:8000/ws

# Mode démonstration.
#   false = l’interface interroge le backend (défaut)
#   true  = données simulées, aucun backend requis
# Indispensable pour présenter l'interface sans lancer l'API.
VITE_DEMO_MODE=false

# Nom affiché dans l'interface
VITE_APP_NAME=ImmoFlow AI
